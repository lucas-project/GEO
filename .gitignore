# dependencies
node_modules/
.pnp
.pnp.js

# next.js (default + GEO_NEXT_DIST_DIR variants e.g. .next-dev, .next-acceptance)
.next/
.next-*/
out/
build/
dist/

# env & secrets
.env
.env.*
!.env.example

# prisma (local sqlite / acceptance DBs - never commit)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
prisma/migrations/dev/

# cursor / IDE local debug dumps
.cursor/*.log

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# os
.DS_Store
Thumbs.db
Desktop.ini

# editors
.vscode/
.idea/
*.swp
*.swo

# playwright / test artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/

# crawl screenshots (Playwright -> public/screenshots/, served at /screenshots/*)
/screenshots/
public/screenshots/*
!public/screenshots/.gitkeep

# temp & local runtime
/tmp/
.cache/

# coverage
coverage/

# vercel
.vercel
