# dependencies
node_modules/
.pnp
.pnp.js

# next.js (default + GEO_NEXT_DIST_DIR variants e.g. .next-dev, .next-acceptance)
.next/
.next-*/
out/
build/
dist/

# env & secrets
.env
.env.*
!.env.example

# prisma (local sqlite / acceptance DBs - never commit)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal
prisma/migrations/dev/

# sqlite at repo root (e.g. DATABASE_URL=file:./dev.db)
/*.db
/*.db-journal
/*.db-shm
/*.db-wal

# local runtime data (db backups, probe session state — see GEO_DB_BACKUP_DIR)
data/

# codegraph local index (machine-specific; see .codegraph/.gitignore)
.codegraph/

# cursor / IDE local state
.cursor/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# os
.DS_Store
Thumbs.db
Desktop.ini

# editors
.vscode/
.idea/
*.swp
*.swo

# playwright / test artifacts
test-results/
playwright-report/
playwright/.cache/
blob-report/

# crawl screenshots (Playwright -> public/screenshots/, served at /screenshots/*)
/screenshots/
public/screenshots/*
!public/screenshots/.gitkeep

# temp & local runtime
/tmp/
.cache/

# coverage
coverage/

# vercel
.vercel
