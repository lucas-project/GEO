{
  "name": "geo-ai-os",
  "version": "0.1.0",
  "private": true,
  "description": "GEO AI Operating System — AI Search Infrastructure for the AI era",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src workers scripts --max-warnings=0",
    "worker": "cross-env GEO_QUEUE_CONSUMER=true tsx workers/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "playwright:install": "playwright install chromium firefox",
    "cloak:install": "tsx scripts/ensure-cloak-browser.ts",
    "setup": "npm install && npm run prisma:generate && npm run prisma:push && npm run playwright:install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "presence:probe": "tsx scripts/presence-probe.ts",
    "ollama:check": "tsx scripts/check-ollama-simulation.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "maintenance:prune": "tsx scripts/prune-artifacts.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@tanstack/react-query": "^5.62.7",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "cloakbrowser": "^0.3.29",
    "clsx": "^2.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.34.0",
    "@google/generative-ai": "^0.21.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prettier": "^3.8.3",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
