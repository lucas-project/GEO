# ===========================
# GEO AI Operating System
# Environment Configuration
# ===========================

# --- Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database ---
# SQLite for dev (zero-config). Swap to PostgreSQL for production:
#   DATABASE_URL="postgresql://user:pass@host:5432/geo"
# Then: npx prisma migrate deploy
DATABASE_URL="file:./prisma/dev.db"

# --- Queue Driver ---
# "memory" (default, in-process) | "bullmq" (requires REDIS_URL + npm run worker)
QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379
# Set automatically by npm run worker — do not set on Next.js unless you want in-process Bull consumers
# GEO_QUEUE_CONSUMER=true

# --- API auth (optional) ---
# When set, all /api/* routes require Authorization: Bearer <secret> or x-geo-api-key: <secret>
GEO_API_SECRET=

# --- AI Provider ---
# "mock" (default) | "openai" | "anthropic" | "gemini" | "ollama"
AI_PROVIDER=mock

# Optional API keys (only required if AI_PROVIDER set accordingly)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Default model overrides (optional)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local LLM — pull models with `ollama pull llama3.2` and embedding model)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- WordPress REST (optional CMS draft publish from /api/auto-fix) ---
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Monitoring webhooks ---
# POST JSON payload after each monitoring run (used when Site.webhookUrl is empty)
MONITORING_WEBHOOK_URL=

# --- Embeddings (chunk index per audit) ---
GEO_EMBEDDING_MAX_CHUNKS=24

# --- Crawl Engine ---
CRAWL_USER_AGENT="GeoAIBot/0.1 (+https://github.com/geo-ai-os)"
CRAWL_TIMEOUT_MS=30000
CRAWL_MAX_PAGES=20
# When false, ignores robots.txt (local demos only; keep true in production).
CRAWL_RESPECT_ROBOTS=true

# --- Logging ---
LOG_LEVEL=info
