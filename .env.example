# ===========================
# GEO AI Operating System
# Environment Configuration
# ===========================

# --- Core ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Database ---
# SQLite for dev (zero-config). Swap to PostgreSQL for production:
#   DATABASE_URL="postgresql://user:pass@host:5432/geo"
# Then: npx prisma migrate deploy
DATABASE_URL="file:./prisma/dev.db"

# --- Queue Driver ---
# "memory" (default, in-process) | "bullmq" (requires REDIS_URL + npm run worker)
# On worker start, jobs left in "running" are marked failed (e.g. after Ctrl+C on npm run dev).
QUEUE_DRIVER=memory
# In-memory only: up to 2 jobs at once (one heavy crawl + background indexing). Audits are prioritized.
QUEUE_MAX_CONCURRENT=2
REDIS_URL=redis://localhost:6379
# Set automatically by npm run worker — do not set on Next.js unless you want in-process Bull consumers
# GEO_QUEUE_CONSUMER=true

# --- API auth (optional) ---
# When set, all /api/* routes require Authorization: Bearer <secret> or x-geo-api-key: <secret>
GEO_API_SECRET=
# Browser client: set the same value so the dashboard can call /api/* (dev only)
NEXT_PUBLIC_GEO_API_KEY=

# --- Off-site presence probe ---
# Default: cloak (CloakBrowser stealth Chromium). Alternatives: firefox | chromium
PRESENCE_PROBE_BROWSER=cloak
# Optional proxy for CloakBrowser (HTTP/SOCKS5). First run auto-downloads ~200MB binary.
# PRESENCE_PROBE_CLOAK_PROXY=http://user:pass@host:8080
# Human-like mouse/keyboard for WAF-heavy sites (default on)
# PRESENCE_PROBE_CLOAK_HUMANIZE=1
# HTTP timeout for Bing/DDG search supplement only (ms; no Playwright fallback)
# PRESENCE_PROBE_SERP_TIMEOUT_MS=12000
# Hard cap per platform probe (prevents one site from stalling the job)
# PRESENCE_PROBE_PLATFORM_MAX_MS=45000
# Playwright storage_state JSON after manual Reddit login (optional)
# PRESENCE_PROBE_STORAGE_STATE_PATH=./data/reddit-session.json
# Bing/DDG search supplement before platform probes (default on)
# PRESENCE_PROBE_SEARCH_SUPPLEMENT=1
# Max SERP queries per probe (default 8)
# PRESENCE_PROBE_SEARCH_SUPPLEMENT_MAX_QUERIES=18
# LLM keep/reject for search supplement hits (default on when AI_PROVIDER != mock)
# PRESENCE_PROBE_SEARCH_CURATE=0
# LLM brand-aware platform selection before search (default on when AI_PROVIDER != mock)
# PRESENCE_PROBE_SEARCH_PLAN=0
# LLM adaptive follow-up search queries when platforms still missing (default on when AI_PROVIDER != mock)
# PRESENCE_PROBE_SEARCH_ORCHESTRATE=0
# PRESENCE_PROBE_SEARCH_ORCHESTRATE_MAX_ROUNDS=2
# PRESENCE_PROBE_SEARCH_ORCHESTRATE_QUERIES_PER_ROUND=4
# LLM filter for Reddit and Facebook display threads (default on when AI_PROVIDER != mock)
# PRESENCE_PROBE_REDDIT_CURATE=1
# Dedicated Ollama model for presence LLM steps (plan, curation, keywords)
# PRESENCE_PROBE_OLLAMA_MODEL=llama3.1:8b
# Optional Agent Reach CLI enrichment (xhs-cli, rdt-cli, Jina for Zhihu) — see docs/agent-reach-presence.md
# PRESENCE_PROBE_AGENT_REACH=0
# PRESENCE_PROBE_AGENT_REACH_XHS=1
# PRESENCE_PROBE_AGENT_REACH_RDT=0
# PRESENCE_PROBE_AGENT_REACH_JINA=1
# PRESENCE_PROBE_AGENT_REACH_TIMEOUT_MS=20000
# XHS_CLI=
# RDT_CLI=

# --- AI Provider ---
# "mock" (default) | "openai" | "anthropic" | "gemini" | "ollama" | "minimax"
AI_PROVIDER=mock

# Embeddings when AI_PROVIDER=minimax (no MiniMax embed API). Default: mock.
# Set ollama to keep local semantic search: EMBEDDINGS_AI_PROVIDER=ollama
# EMBEDDINGS_AI_PROVIDER=mock

# On-page keyword detection (defaults to AI_PROVIDER / inherit).
# SITE_KEYWORDS_AI_PROVIDER=inherit

# Optional API keys (only required if AI_PROVIDER set accordingly)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Perplexity Sonar — live answers for the Perplexity slot in /simulate (optional)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# Default model overrides (optional)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local LLM — run once: ollama pull llama3.1:8b)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- AI simulation: local multi-model (no cloud API keys) ---
# Use Ollama for simulation only; audits can keep AI_PROVIDER=minimax or openai.
# SIMULATION_AI_PROVIDER=ollama
# Pull four models (examples — use any models you have):
#   ollama pull llama3.2
#   ollama pull qwen2.5:7b
#   ollama pull mistral
#   ollama pull gemma2:2b
# SIMULATION_OLLAMA_CHATGPT=llama3.2
# SIMULATION_OLLAMA_GEMINI=qwen2.5:7b
# SIMULATION_OLLAMA_CLAUDE=mistral
# SIMULATION_OLLAMA_PERPLEXITY=gemma2:2b
# Shorter answers = faster batch tests (Ollama num_predict; default 512)
# SIMULATION_MAX_TOKENS=512
# Parallel batch prompts: 0=auto (1 for ollama, 2 for cloud), or set 1-4
# SIMULATION_BATCH_CONCURRENCY=1
# Batch speed: one Ollama model for all platform slots (default on for SIMULATION_AI_PROVIDER=ollama)
# SIMULATION_BATCH_SINGLE_MODEL=1
# Shorter answers during batch (default 384; single runs use SIMULATION_MAX_TOKENS)
# SIMULATION_BATCH_MAX_TOKENS=384
# Skip re-loading Ollama weights if batch ran within N minutes (default 12)
# SIMULATION_WARM_CACHE_MINUTES=12
# Keep Ollama models loaded between platform calls (e.g. 15m; enables parallel platform queries)
# SIMULATION_OLLAMA_KEEP_ALIVE=15m
# Extra LLM pass to extract citations on single runs (batch uses one combined MiniMax pass per question)
# SIMULATION_LLM_CITATIONS=0

# Optional: OpenAI-compatible gateway (LiteLLM, LocalAI, LM Studio) for cloud or local models
# OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# OPENAI_API_KEY=sk-anything
# Stronger presence filtering (optional; defaults to llama3.1:8b)
# PRESENCE_PROBE_OLLAMA_MODEL=llama3.1:8b
# GEO content can share the same model:
# GEO_CONTENT_OLLAMA_MODEL=llama3.1:8b

# MiniMax (OpenAI-compatible) — https://platform.minimax.io
# AI_PROVIDER=minimax
# MINIMAX_API_KEY=
# CN / Token Plan keys (sk-cp-): https://api.minimaxi.com/v1
# Global pay-as-you-go keys: https://api.minimax.io/v1
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# Do not wrap MINIMAX_API_KEY in quotes in .env
# MINIMAX_MODEL=MiniMax-M2.5
# PRESENCE_PROBE_MINIMAX_MODEL=MiniMax-M2.5
# GEO_CONTENT_MINIMAX_MODEL=MiniMax-M2.5
# SITE_KEYWORDS_MINIMAX_MODEL=MiniMax-M2.5

# --- WordPress REST (optional CMS draft publish from /api/auto-fix) ---
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- Monitoring webhooks ---
# POST JSON payload after each monitoring run (used when Site.webhookUrl is empty)
MONITORING_WEBHOOK_URL=
# Default re-audit interval when adding a site (hours)
MONITOR_INTERVAL_HOURS=24
# Secret for POST /api/cron/monitor (Vercel cron / external scheduler)
CRON_SECRET=
# BullMQ repeatable cron for monitoring.sweep (default: daily 06:00 UTC)
MONITOR_SWEEP_CRON=0 6 * * *
# In-memory queue: enqueue monitoring.sweep every N ms (0 = disabled; e.g. 3600000 = 1h)
MONITOR_SCHEDULER_MS=0
INTELLIGENCE_MIN_COHORT_SAMPLES=20
INTELLIGENCE_EMBED_SCORE_THRESHOLD=80
INTELLIGENCE_CITATION_EMBED_THRESHOLD=0.4
INTELLIGENCE_READABILITY_HIGH=75
MONITOR_FAILURE_BACKOFF_HOURS=6
MONITOR_MAX_BACKOFF_HOURS=72
MONITOR_LOCK_TIMEOUT_MINUTES=45
MONITOR_CITATION_DELTA_THRESHOLD=0.15
MONITOR_ENTITY_DELTA_THRESHOLD=3
MONITOR_READABILITY_DELTA_THRESHOLD=12
MONITOR_HEALTH_CHECK_MAX_PAGES=2

# --- Embeddings (chunk index per audit) ---
GEO_EMBEDDING_MAX_CHUNKS=24

# --- Crawl Engine ---
CRAWL_USER_AGENT="GeoAIBot/0.1 (+https://github.com/geo-ai-os)"
CRAWL_TIMEOUT_MS=30000
CRAWL_MAX_PAGES=20
# When false, ignores robots.txt (local demos only; keep true in production).
CRAWL_RESPECT_ROBOTS=true

# --- Logging ---
LOG_LEVEL=info
