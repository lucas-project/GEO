// GEO AI Operating System — Database Schema
//
// Uses SQLite in dev for zero-config local boot. To switch to PostgreSQL for
// production, change `provider = "postgresql"` and update DATABASE_URL.
// All Json columns are written via Prisma's Json type (works on both
// SQLite and Postgres via the JSON serialization layer).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Local, invite-only accounts and workspaces. Site.ownerId is a workspace id
// for authenticated requests; it has no foreign key so legacy local rows keep
// working during a non-destructive migration.
model User {
  id             String                @id @default(cuid())
  email          String                @unique
  passwordHash   String
  passwordSalt   String
  passwordParams String
  createdAt      DateTime              @default(now())
  sessions       AuthSession[]
  memberships    WorkspaceMembership[]
}

model Workspace {
  id          String                @id @default(cuid())
  name        String
  createdAt   DateTime              @default(now())
  memberships WorkspaceMembership[]
  sessions    AuthSession[]
  invites     Invite[]
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("viewer") // owner | editor | viewer
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model AuthSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  workspaceId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([expiresAt])
}

model Invite {
  id          String    @id @default(cuid())
  codeHash    String    @unique
  workspaceId String
  email       String?
  role        String    @default("viewer") // owner | editor | viewer
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------
// JOBS — generic async work tracking (audits, simulations, etc.)
// ---------------------------------------------------------------
model Job {
  id        String   @id @default(cuid())
  type      String
  status    String   @default("pending") // pending | running | completed | failed | cancelled
  progress  Int      @default(0)
  statusMessage String?
  payload   String   // JSON-encoded
  result    String?  // JSON-encoded
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  startedAt DateTime?
  finishedAt DateTime?
  /** Compare-and-set execution lease; prevents two workers completing one job. */
  leaseToken String?
  leaseExpiresAt DateTime?
  heartbeatAt DateTime?
  attempt Int @default(0)
  /** Stable caller key for idempotent enqueue (optional during migration). */
  idempotencyKey String?
  budget String? // JSON-encoded task budget
  usage String? // JSON-encoded measured usage

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([leaseExpiresAt])
  @@index([idempotencyKey])
}

// ---------------------------------------------------------------
// SITES — the target websites being optimized for AI visibility
// ---------------------------------------------------------------
model Site {
  userEvidence String @default("[]")
  id          String   @id @default(cuid())
  url         String
  name        String?
  ownerId     String   @default("local")
  monitored   Boolean  @default(false)
  /** Optional HTTPS URL for POST JSON monitoring alerts after each run */
  webhookUrl  String?
  /** Continuous monitoring schedule */
  monitorEnabled         Boolean   @default(true)
  monitorIntervalHours   Int       @default(24)
  /** 12h | daily | weekly | adaptive — resolved to monitorIntervalHours */
  monitorSchedulePreset  String    @default("daily")
  /** After crawl failures: lighter health-check runs until success */
  monitorHealthCheck     Boolean   @default(false)
  nextRunAt              DateTime?
  lastMonitorStatus    String?
  lastMonitorError     String?
  timezone             String    @default("UTC")
  /** Cohort tagging for benchmarks */
  vertical             String?
  cohortTags           String?   // JSON string[]
  /** Deterministic site identity draft; confirmation is an explicit user action. */
  profile              String?
  profileVersion       String?
  profileConfirmedAt   DateTime?
  profileConfirmedBy   String?
  /** Opt-in: run AI simulation on each monitor cycle (costly) */
  monitorSimulation    Boolean   @default(false)
  /** Consecutive monitor failures — drives exponential backoff */
  monitorFailureCount  Int       @default(0)
  /** Set while a monitor audit is in flight (duplicate-run guard) */
  monitorLockedAt      DateTime?
  /** JSON string[] — same-origin URLs to re-audit on each monitor run */
  monitorPageUrls      String?
  /** JSON string[] — AI-generated simulation questions to re-run each monitor cycle */
  monitorSimulationPrompts String?
  createdAt   DateTime @default(now())

  audits            GeoAudit[]
  competitorReports CompetitorReport[]
  monitoringRuns    MonitoringRun[]
  auditRollups        AuditRollup[]
  citationSnapshots CitationSnapshot[]
  fixOutcomes       FixOutcome[]
  patternEmbeddings PatternEmbedding[]
  geoContentPacks   GeoContentPack[]

  @@unique([ownerId, url])
  @@index([ownerId])
}

// ---------------------------------------------------------------
// GEO CONTENT PACKS — server-persisted content idea outputs
// ---------------------------------------------------------------
model GeoContentPack {
  id        String   @id @default(cuid())
  auditId   String
  siteId    String?
  url       String
  payload   String   // JSON: GeoContentPack + keywords metadata
  createdAt DateTime @default(now())

  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([auditId])
  @@index([url])
  @@index([createdAt])
}

// ---------------------------------------------------------------
// GEO AUDITS — primary Phase 1 output
// ---------------------------------------------------------------
model GeoAudit {
  id            String   @id @default(cuid())
  siteId        String?
  url           String
  overallScore  Int      @default(0)
  scoreVersion  String   @default("hierarchical-v2")
  coverage      Float?
  revision      Int      @default(1)
  sampleManifest String  @default("[]")
  recomputedAt  DateTime?
  dimensions    String   // JSON: dimension -> {score, reasons[]}
  /** Hierarchical pipeline: layers, citation probability, bottleneck, gates */
  scoringMeta   String   @default("{}")
  narrative     String?  // LLM-generated human summary
  topIssues     String   // JSON: Issue[]
  topFixes      String   // JSON: Fix[]
  screenshotUrl String?
  /** Discovered + audited page URLs for the report UI */
  pageInventory String   @default("[]")
  status        String   @default("completed")
  createdAt     DateTime @default(now())

  site               Site?                   @relation(fields: [siteId], references: [id])
  crawlResults       CrawlResult[]
  extractionResults  ExtractionResult[]
  optimizations      OptimizationSuggestion[]
  monitoringRuns     MonitoringRun[]
  chunkEmbeddings    ChunkEmbedding[]

  @@index([siteId])
  @@index([url])
  @@index([createdAt])
}

// ---------------------------------------------------------------
// CHUNK EMBEDDINGS — Phase 3 moat (vector JSON; pgvector-ready in prod)
// ---------------------------------------------------------------
model ChunkEmbedding {
  id           String   @id @default(cuid())
  auditId      String
  chunkIndex   Int
  textPreview  String
  dimensions   Int      @default(256)
  vector       String   // JSON number[] — store pgvector later via raw SQL if needed
  model        String
  createdAt    DateTime @default(now())

  audit GeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ---------------------------------------------------------------
// CRAWL RESULTS — raw + rendered HTML per page
// ---------------------------------------------------------------
model CrawlResult {
  id             String   @id @default(cuid())
  auditId        String
  url            String
  statusCode     Int      @default(0)
  html           String?
  renderedHtml   String?
  screenshotPath String?
  contentType    String?
  fetchedAt      DateTime @default(now())
  durationMs     Int      @default(0)
  error          String?
  fetchStatus    String?
  blockReason    String?
  contentHash    String?
  htmlTruncated  Boolean  @default(false)
  rawHtmlAvailable      Boolean @default(false)
  renderedHtmlAvailable Boolean @default(false)
  fetchProfile   String?
  fetchChannel   String?

  audit GeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ---------------------------------------------------------------
// EXTRACTION RESULTS — structured representation of a page
// ---------------------------------------------------------------
model ExtractionResult {
  id        String   @id @default(cuid())
  auditId   String
  url       String
  metadata  String   // JSON
  headings  String   // JSON
  schemas   String   // JSON (JSON-LD found)
  faqs      String   // JSON
  entities  String   // JSON
  chunks    String   // JSON
  links     String   // JSON
  tables    String   // JSON (comparison tables)
  authors   String   // JSON (author signals)
  checklist String   @default("{}") // JSON (GEO ref checklist signals)
  createdAt DateTime @default(now())

  audit GeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ---------------------------------------------------------------
// AI SIMULATIONS — Phase 2 output
// ---------------------------------------------------------------
model AiSimulation {
  id            String   @id @default(cuid())
  siteId        String?
  prompt        String
  platform      String   // "chatgpt" | "gemini" | "claude" | "perplexity"
  runId         String?
  targetBrand   String?  // optional visibility target; duplicated per row for a run
  responseText  String
  citations     String   // JSON: {url, brand, position}[]
  brandMentions String   // JSON: {brand, count}[]
  /** live | local | persona | mock; legacy rows remain unknown until rerun. */
  executionMode String?
  provider      String?
  model         String?
  tokens        String?
  retrievalEnabled Boolean @default(false)
  createdAt     DateTime @default(now())

  @@index([siteId])
  @@index([runId])
  @@index([executionMode])
  @@index([prompt])
}

// ---------------------------------------------------------------
// COMPETITOR REPORTS — Phase 2 cross-site diffs
// ---------------------------------------------------------------
model CompetitorReport {
  id            String   @id @default(cuid())
  siteId        String?
  targetUrl     String
  competitorUrl String
  diff          String   // JSON
  createdAt     DateTime @default(now())

  site Site? @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@index([targetUrl])
}

// Full comparison payload for UI (one row per queued compare job)
model ComparisonRun {
  id        String   @id
  ownerId   String   @default("local")
  targetUrl String
  payload   String // JSON: CompetitorComparison
  createdAt DateTime @default(now())

  @@index([targetUrl])
  @@index([ownerId])
  @@index([createdAt])
}

// ---------------------------------------------------------------
// OPTIMIZATION SUGGESTIONS — Phase 3 generated artifacts
// ---------------------------------------------------------------
model OptimizationSuggestion {
  evidenceIds      String @default("[]")
  sourceRevision   Int?
  contentFormat    String @default("text")
  disposition      String @default("draft")
  recheckAuditId   String?
  id               String   @id @default(cuid())
  auditId          String
  type             String   // "faq-schema" | "llms-txt" | "ai-summary" | "answer-first" | ...
  targetUrl        String?
  generatedContent String
  rationale        String?
  applied          Boolean  @default(false)
  createdAt        DateTime @default(now())

  audit GeoAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
}

// ---------------------------------------------------------------
// MONITORING RUNS — Phase 4 scheduled re-audits
// ---------------------------------------------------------------
model MonitoringRun {
  id        String   @id @default(cuid())
  siteId    String
  auditId   String?
  diff      String?  // JSON
  alerts    String   // JSON: Alert[]
  runAt     DateTime @default(now())

  site  Site      @relation(fields: [siteId], references: [id])
  audit GeoAudit? @relation(fields: [auditId], references: [id])

  @@index([siteId])
  @@index([runAt])
}

// ---------------------------------------------------------------
// API KEYS — BYOK storage
// ---------------------------------------------------------------
model ApiKey {
  id           String   @id @default(cuid())
  ownerId      String   @default("local")
  provider     String   // "openai" | "anthropic" | "gemini"
  encryptedKey String
  label        String?
  createdAt    DateTime @default(now())

  @@index([ownerId])
}

// ---------------------------------------------------------------
// AGENT PLANS — Phase 5
// ---------------------------------------------------------------
model AgentPlan {
  id             String   @id @default(cuid())
  goal           String
  plan           String   // JSON: {steps: PlanStep[]}
  status         String   @default("planned") // planned | running | completed | failed
  result         String?  // JSON
  /** User requested stop; executor checks between steps. */
  stopRequested  Boolean  @default(false)
  /** Latest queued `agent.run` job id (for cancel while pending). */
  activeJobId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------
// INTELLIGENCE — cross-audit rollups and cohort patterns
// ---------------------------------------------------------------
model AuditRollup {
  id               String   @id @default(cuid())
  siteId           String
  auditId          String   @unique
  overallScore     Int
  dimensionScores  String   // JSON: Record<Dimension, number>
  schemaTypes      String   // JSON: string[] — legacy mirror of signals
  faqCount         Int      @default(0)
  chunkCount       Int      @default(0)
  answerFirstRatio Float?
  /** Full GEO signal bundle (hierarchy, entities, tables, readability, etc.) */
  signals          String   @default("{}")
  vertical         String?
  createdAt        DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
}

model CitationSnapshot {
  id                    String   @id @default(cuid())
  siteId                String
  auditId               String?
  platformBreakdown     String   @default("{}")
  citedDomains          String   @default("[]")
  targetVisibilityScore Float    @default(0)
  createdAt             DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([auditId])
}

model IssueOccurrence {
  id        String   @id @default(cuid())
  auditId   String
  siteId    String?
  issueKey  String
  severity  String
  dimension String
  createdAt DateTime @default(now())

  @@index([issueKey])
  @@index([siteId])
  @@index([auditId])
}

model PatternStat {
  id              String   @id @default(cuid())
  cohortKey       String
  patternType     String
  patternKey      String
  sampleCount     Int
  avgOverallScore Float
  p50Score        Float?
  metadata        String   @default("{}")
  updatedAt       DateTime @updatedAt

  @@unique([cohortKey, patternType, patternKey])
  @@index([cohortKey])
}

model FixOutcome {
  id              String    @id @default(cuid())
  siteId          String
  optimizationId  String?
  issueKey        String
  artifactType    String
  scoreBefore     Int
  scoreAfter      Int?
  dimensionBefore String
  dimensionAfter  String?
  appliedAt       DateTime  @default(now())
  verifiedAt      DateTime?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([optimizationId])
}

/** High-scoring chunk patterns for cohort RAG */
model PatternEmbedding {
  id            String   @id @default(cuid())
  siteId        String?
  cohortKey     String
  auditId       String
  chunkIndex    Int
  textPreview   String
  overallScore  Int
  dimensions    Int      @default(256)
  vector        String
  model         String
  signalTags    String   @default("[]")
  dimensionHint String?
  industry      String?
  createdAt     DateTime @default(now())

  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([cohortKey])
  @@index([auditId])
}
